# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# ---------- Virtual environments ----------
.venv/
venv/
env/
ENV/

# ---------- Jupyter ----------
.ipynb_checkpoints/
*/.ipynb_checkpoints/

# ---------- Testing / linting caches ----------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---------- IDEs / OS ----------
.vscode/
.idea/
.DS_Store
Thumbs.db

# ---------- Secrets & local config ----------
# Never commit credentials. Keep docker.env only if it contains no secrets.
.env
*.env.local
secrets/

# ---------- Airflow ----------
logs/
airflow-webserver.pid
airflow.db
airflow.cfg
unittests.cfg
standalone_admin_password.txt

# ---------- Docker ----------
docker-compose.override.yml

# ---------- Data ----------
# Processed splits are regenerated by the pipeline.
data/processed/*
data/raw/*
!data/processed/.gitkeep
data/interim/

# ---------- Models ----------
models/*

# ---------- Reports ----------
# Keep final figures; ignore scratch outputs.
reports/scratch/

# ---------- Misc ----------
*.log
*.bak
*.swp
